# Copy to .env.local (git-ignored) and adjust. Never commit .env.local.

# MariaDB / MySQL connection (XAMPP default: root, no password, port 3307 on this machine)
DATABASE_URL=mysql://root@127.0.0.1:3307/homework2
# Hosted MySQL (e.g. TiDB Cloud Starter) needs TLS: set the hosted URL and DATABASE_SSL=true
# DATABASE_URL=mysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/homework2
DATABASE_SSL=false

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
